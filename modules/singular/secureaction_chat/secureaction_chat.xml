<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Script file="secureaction_chat.lua"/>

    <Button name="Camper_SendChatMsgSecureActionButton" parentKey="Camper_SendChatMsgSecureActionButton" mixin="Camper_SendChatMsgSecureActionButtonMixin" inherits="Legolando_SimpleSquareButtonTemplate_Camper, SecureActionButtonTemplate" hidden="false">
        <Anchors>
            <Anchor point="CENTER" x="-100" y="100"/>
        </Anchors>
        <Size x="64" y="64"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnEnter>
                self.closeButton:Show()
            </OnEnter>
            <OnLeave>
                if not self.closeButton:IsMouseOver() then
                    self.closeButton:Hide()
                end
            </OnLeave>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
            <OnEvent method="OnEvent"/>
        </Scripts>
        <Frames>
            <Button name="$parent_CloseButton" parentKey = "closeButton" inherits="UIPanelCloseButton" hidden="true">
                <Anchors>
                    <Anchor point = "CENTER" relativeTo="$parent" relativePoint="TOPRIGHT" x="-10" y="-10"/>
                </Anchors>
                <Size x="20" y="20"/>
                <Scripts>
                    <OnClick>
                        local parent = self:GetParent()
                        parent:ResetDelayer()
                        parent:ClearAttributes()
                        parent:Hide()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Button>


</Ui>