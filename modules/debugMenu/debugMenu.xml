<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Frame name="Camper_DebugMenu" parentKey="Camper_DebugMenu" toplevel="true" clampedToScreen="true" FrameStrata="MEDIUM" inherits="BasicFrameTemplateWithInset" hidden="true">
        <Size x="350" y="300"/>
        <Anchors>
            <Anchor point="CENTER" relativeTo="UIParent" relativePoint="CENTER" x="500" y="100"/>
        </Anchors>
        <Scripts>
            <OnLoad>
                tinsert(UISpecialFrames, self:GetName())
                self.TitleText:SetText("Camper Debug Menu(ONLY FOR TESTING)")
                self:SetMovable(true)
                self:RegisterForDrag("LeftButton")
            </OnLoad>
            <OnMouseDown>
                self:Raise()
            </OnMouseDown>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
        <Frames>
            <Frame name="$parent_Checkboxes" parentKey="checkboxes" inherits="Legolando_CheckboxesTemplate_Camper">
                <Size x="1" y="1"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT" x="20" y="-40"/>
                </Anchors>
                <Frames>
                    <Frame parentKey="debugMode" inherits="Legolando_CheckboxFrameTemplate_Camper">
                        <Size x="26" y="26"/>
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="10" y="-5"/>
                        </Anchors>
                    </Frame>
                    <Frame parentKey="spellTester" inherits="Legolando_CheckboxFrameTemplate_Camper">
                        <Size x="26" y="26"/>
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="10" y="-30"/>
                        </Anchors>
                    </Frame>
                    <Frame parentKey="simulationEnabled" inherits="Legolando_CheckboxFrameTemplate_Camper">
                        <Size x="26" y="26"/>
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="BOTTOMLEFT" x="10" y="-55"/>
                        </Anchors>
                    </Frame>
                </Frames>
            </Frame>
        </Frames>
    </Frame>


</Ui>