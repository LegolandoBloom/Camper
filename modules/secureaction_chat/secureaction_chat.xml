<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Script file="secureaction_chat.lua"/>

    <Button name="Camper_SendChatMsgSecureActionButton" parentKey="Camper_SendChatMsgSecureActionButton" mixin="Camper_SendChatMsgSecureActionButtonMixin" inherits="Legolando_SimpleSquareButtonTemplate_Camper, SecureActionButtonTemplate" hidden="false">
        <Anchors>
            <Anchor point="CENTER" x="-100" y="100"/>
        </Anchors>
        <Size x="64" y="64"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
            <OnHide method="OnHide"/>
            <OnEnter>
                self.closeButton:Show()
                local tooltipText = self.tooltipText
                if not tooltipText then return end
                local tooltipTitle = self.tooltipTitle
                if not tooltipTitle then tooltipTitle = " " end
                GameTooltip:SetOwner(self, "ANCHOR_LEFT", 0, -67)
                GameTooltip:AddLine(tooltipTitle)
                GameTooltip:AddLine("\n")
                GameTooltip:AddLine(tooltipText, 1, 1, 1, false)
                GameTooltip:Show()
            </OnEnter>
            <OnLeave>
                if not self.closeButton:IsMouseOver() then
                    self.closeButton:Hide()
                end
                GameTooltip:Hide()
            </OnLeave>
            <OnDragStart method="OnDragStart"/>
            <OnDragStop method="OnDragStop"/>
            <OnEvent method="OnEvent"/>
        </Scripts>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parent_Title" parentKey="title"  inherits="GameFontNormal" hidden="false">
                    <Anchors>
                        <Anchor point="BOTTOM" relativeKey="$parent" relativePoint="TOP" x="0" y="5"/>
                    </Anchors>
                </FontString>
                <FontString name="$parent_HideTimer" parentKey="hideTimer" inherits="NumberFont_Shadow_Small" hidden="false">
                    <Anchors>
                        <Anchor point="TOP" relativeKey="$parent" relativePoint="BOTTOM" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parent_CloseButton" parentKey = "closeButton" inherits="UIPanelCloseButton" hidden="true">
                <Anchors>
                    <Anchor point = "CENTER" relativeTo="$parent" relativePoint="TOPRIGHT" x="-10" y="-10"/>
                </Anchors>
                <Size x="20" y="20"/>
                <Scripts>
                    <OnClick>
                        local parent = self:GetParent()
                        parent:ResetDelayer()
                        parent:ClearAttributes()
                        parent:Hide()
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Button>


</Ui>